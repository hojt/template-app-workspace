{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [".devcontainer/agent/instructions.md"],
  "permission": {
    "*": "allow",
    "edit": {
      "*": "allow",
      ".opencode/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "npm publish*": "deny",
      "./mvnw deploy*": "deny",
      "mvn deploy*": "deny"
    },
    "webfetch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
