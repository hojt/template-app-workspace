{
  "name": "${localWorkspaceFolderBasename}-agent",
  "build": {
    "dockerfile": "../Containerfile",
    "context": "../..",
    "target": "agent"
  },
  "workspaceMount": "source=${localWorkspaceFolderBasename}-agent-workspaces,target=/agent-workspaces/${localWorkspaceFolderBasename},type=volume,U",
  "workspaceFolder": "/agent-workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    // Read-only source for the agent's clone. See ADR-0011.
    "source=${localWorkspaceFolder}/.git,target=/upstream/${localWorkspaceFolderBasename}.git,type=bind,readonly,relabel=shared",
    // Agent-only state
    "target=/agent-workspaces/${localWorkspaceFolderBasename}/.opencode,type=tmpfs,notmpcopyup,tmpfs-mode=1777",
    "target=/agent-workspaces/${localWorkspaceFolderBasename}/.claude,type=tmpfs,notmpcopyup,tmpfs-mode=1777",
    "source=${localWorkspaceFolderBasename}-agent-opencode-data,target=/home/developer/.local/share/opencode,type=volume",
    "source=${localWorkspaceFolderBasename}-agent-claude-config,target=/home/developer/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-agent-maven-cache,target=/home/developer/.m2,type=volume",
    "source=${localWorkspaceFolderBasename}-agent-npm-cache,target=/home/developer/.npm,type=volume"
  ],
  "runArgs": [
    "--network=${localWorkspaceFolderBasename}-agent",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--memory=16g",
    "--cpus=8",
    "--pids-limit=2048"
  ],
  "remoteUser": "developer",
  "containerUser": "developer",
  "containerEnv": {
    "OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER": "1",
    "HTTP_PROXY": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "HTTPS_PROXY": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "http_proxy": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "https_proxy": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "NO_PROXY": "localhost,127.0.0.1",
    "no_proxy": "localhost,127.0.0.1",
    "NODE_USE_ENV_PROXY": "1",
    "AGENT_PROXY_HOST": "${localWorkspaceFolderBasename}-agent-proxy",
    "MAVEN_ARGS": "--global-settings /agent-workspaces/${localWorkspaceFolderBasename}/.devcontainer/agent/maven-settings.xml -Dmaven.clean.failOnError=false",
    "CLAUDE_CONFIG_DIR": "/home/developer/.claude",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "updateRemoteUserUID": true
}
