{
  "name": "template-app-workspace",
  "build": {
    "dockerfile": "Containerfile",
    "context": "..",
    "target": "development"
  },
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "CONTAINER_HOST": "unix:///run/podman/podman.sock",
    "DOCKER_HOST": "unix:///run/podman/podman.sock"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/run/podman/podman.sock,type=bind",
    "source=template-app-workspace-maven-cache,target=/home/developer/.m2,type=volume",
    "source=template-app-workspace-npm-cache,target=/home/developer/.npm,type=volume",
    "source=${localEnv:HOME}/.config/nvim,target=/home/developer/.config/nvim,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/developer/.gitconfig,type=bind,readonly",
    "source=template-app-workspace-nvim-data,target=/home/developer/.local/share/nvim,type=volume"
  ],
  "runArgs": [
    "--security-opt=label=disable",
    "--publish=127.0.0.1:${localEnv:FRONTEND_HOST_PORT:5173}:5173"
  ],
  "remoteUser": "developer",
  "containerUser": "developer",
  "updateRemoteUserUID": true
}
